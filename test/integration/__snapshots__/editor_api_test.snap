   "name": "greeter",
   "proto_files": [
    {
     "content": "syntax = \"proto3\";\npackage test;\n\nmessage HelloRequest {\n  string user_id = 1;\n}\n\nmessage HelloReply {\n  string message = 1;\n}\n\nservice Greeter {\n  rpc Hello (HelloRequest) returns (HelloReply);\n}\n",
     "name": "greeter.proto"
    }
   ],
   "stubs": [
    {
     "content": "{\n  \"request\": {\"url\": \"/test.Greeter/Hello\", \"body\": {\"user_id\": \"bob\"}},\n  \"response\": {\"status\": 200, \"message\": \"test.HelloReply\", \"body\": {\"message\": \"hi bob\"}, \"proto\": true}\n}",
     "file": "bob.json",
